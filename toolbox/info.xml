<?xml version="1.0" encoding="utf-8"?>
<productinfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="optional">
    <!-- info.xml for the Group Stats Toolbox. Keep these six elements in
         this order; the parser reads every one, including the two that
         nothing uses. -->
    <!-- (Required) Release of MATLAB. Not used, but required to parse
         the file. -->
    <matlabrelease>R2021a</matlabrelease>
    <!-- (Required) Title of the toolbox. Appears in the Contents pane. -->
    <name>Group Stats</name>
    <!-- (Required) Label for the toolbox, one of matlab, toolbox,
         simulink, blockset, links_targets. -->
    <type>toolbox</type>
    <!-- (Required) Icon file for the Start button. Not used, but required
         to parse the file. -->
    <icon></icon>
    <!-- (Required if you supply help) Relative path to the help (HTML)
         folder. -->
    <help_location>docs/html</help_location>
    <!-- (Required if you supply help) Icon for the Help browser TOC.
         Ignored in R2015a and later. -->
    <help_contents_icon></help_contents_icon>
</productinfo>
