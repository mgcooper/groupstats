{
   "_schemaVersion": "1.0.0",
   "groupstats.barchartcats":
   {
      "inputs":
      [
         {
            "name":"tbl",
            "kind":"required",
            "type":"tabular",
            "purpose":"the table containing the input data"
         },
         {
            "name":"ydatavar",
            "kind":"required",
            "type":
            [
               ["cellstr","char","string","vartype","pattern"],
               ["scalar"],
               ["choices=tablecompletions(tbl, 'rowtimes', true)"]
            ],
            "purpose":"the data variable"
         },
         {
            "name":"xgroupvar",
            "kind":"required",
            "type":
            [
               ["cellstr","char","string","vartype","pattern"],
               ["scalar"],
               ["choices=tablecompletions(tbl, 'rowtimes', true)"]
            ],
            "purpose":"the table variable for grouping along the x axis"
         },
         {
            "name":"cgroupvar",
            "kind":"required",
            "type":
            [
               ["cellstr","char","string","vartype","pattern"],
               ["scalar"],
               ["choices=tablecompletions(tbl, 'rowtimes', true)"]
            ],
            "purpose":"the table variable for grouped by color"
         },
         {
            "name":"XGroupMembers",
            "kind":"namevalue",
            "type":"choices=tablecompletions(tbl, 'selectby', xgroupvar)",
            "purpose":"the grouping variable members"
         },
         {
            "name":"CGroupMembers",
            "kind":"namevalue",
            "type":"choices=tablecompletions(tbl, 'selectby', cgroupvar)",
            "purpose":"the color grouping variable members"
         },
         {
            "name":"RowSelectVar",
            "kind":"namevalue",
            "type":
            [
               ["cellstr","char","string","vartype","pattern"],
               ["scalar"],
               ["choices=tablecompletions(tbl)"]
            ],
            "purpose":"the variable to down-select rows of input table"
         },
         {
            "name":"RowSelectMembers",
            "kind":"namevalue",
            "type":"choices=tablecompletions(tbl,'selectby',RowSelectVar)",
            "purpose":"the group members to down-select rows of input table"
         },
         {
            "name":"method", 
            "kind":"namevalue", 
            "type":
            [
               "char", "string", "scalar", 
               "choices=groupstats.namelists.centralstatistic()"
            ],
            "default":"'mean'",
            "purpose":"the method used to summarize the data"
         },
         {
            "name":"SortBy", 
            "kind":"namevalue", 
            "type":
            [
               "char", "string", "scalar", 
               "choices=groupstats.namelists.sortorder()"
            ], 
            "default":"'none'",
            "purpose":"the method used to order the bars along the x-axis"
         },
         {
            "name":"SortGroupMembers",
            "kind":"namevalue",
            "type":"choices=tablecompletions(tbl,'selectby',cgroupvar)",
            "purpose":"the cgroup members to compute sortby order"
         },
         {
            "name":"ShadeGroups",
            "kind":"namevalue",
            "type":["logical", "scalar"],
            "default":"false",
            "purpose":"shade alternate x-tick groups"
         },
         {
            "name":"PlotError",
            "kind":"namevalue",
            "type":["logical", "scalar"],
            "default":"false",
            "purpose":"draw a whisker per bar from the spread of its group"
         },
         {
            "name":"XGroupOrder",
            "kind":"namevalue",
            "type":
            [
               ["char","string"],
               ["choices=tablecompletions(tbl, 'selectby', xgroupvar)"]
            ],
            "default":"'none'",
            "purpose":"the variables in the order they should be plotted"
         },
         {
            "name":"CGroupOrder",
            "kind":"namevalue",
            "type":
            [
               ["char","string"],
               ["choices=tablecompletions(tbl, 'selectby', cgroupvar)"]
            ],
            "default":"'none'",
            "purpose":"the variables in the order they should be plotted"
         },
         {
            "name":"Legend",
            "kind":"namevalue",
            "type":
            [
               ["char", "string", "cellstr"],
               ["notempty"],
               ["choices=groupstats.namelists.legendvisibility()"]
            ],
            "default":"'on'",
            "purpose":"toggle to turn legend on or off"
         },
         {
            "name":"LegendString",
            "kind":"namevalue",
            "type":
            [
               ["char", "string", "cellstr"],
               ["notempty"]
            ],
            "purpose":"the legend string"
         },
         {
            "name":"LegendOrientation",
            "kind":"namevalue",
            "type":
            [
               ["char", "string"],
               ["scalar"],
               ["choices=groupstats.namelists.legendorientation()"]
            ],
            "purpose":"the legend orientation"},
         {
            "name":"props",
            "kind":"properties",
            "type":"matlab.graphics.chart.primitive.Bar"}
      ],
      "outputs":
      [
         {
            "name":"H",
            "type":"matlab.graphics.chart.primitive.Bar",
            "purpose":"the barchart handle"
         },
         {
            "name":"L",
            "type":"matlab.graphics.illustration.Legend",
            "purpose":"the legend handle"
         }
      ],
      "description":"Create bar chart of grouped data"
   },
   "groupstats.groupselect":
   {
      "inputs":
      [
         {"name":"tbl", "kind":"required", "type":["tabular"], "purpose":"the table to select rows from"},
         {"name":"varnames", "kind":"required", "type":[["cellstr","char","string"],["choices=tablecompletions(tbl)"]], "purpose":"the grouping variables"},
         {"name":"groupmembers", "kind":"required", "type":[["cellstr","char","string"]], "purpose":"the members to keep"}
      ]
   },

   "groupstats.grouppercent":
   {
      "inputs":
      [
         {"name":"tbl", "kind":"required", "type":["tabular"], "purpose":"the table of grouped data"},
         {"name":"groupvars", "kind":"required", "type":[["cellstr","char","string"],["choices=tablecompletions(tbl)"]], "purpose":"the grouping variables"},
         {"name":"groupbins", "kind":"ordered", "purpose":"the binning scheme for each grouping variable"},
         {"name":"groupsets", "kind":"ordered", "type":[["cellstr","char","string"],["choices=tablecompletions(tbl)"]], "purpose":"the variables defining the set each percent is taken within"}
      ]
   },

   "groupstats.groupdifference":
   {
      "inputs":
      [
         {"name":"tbl", "kind":"required", "type":["tabular"], "purpose":"the table of grouped data"},
         {"name":"groupvar", "kind":"required", "type":[["cellstr","char","string"],["scalar"],["choices=tablecompletions(tbl)"]], "purpose":"the grouping variable"},
         {"name":"datavar", "kind":"required", "type":[["cellstr","char","string"],["scalar"],["choices=tablecompletions(tbl)"]], "purpose":"the data variable to compare"},
         {"name":"ReferenceGroup", "kind":"namevalue", "type":"choices=tablecompletions(tbl,'selectby',groupvar)", "purpose":"the member every other member is compared against"},
         {"name":"conditionvar", "kind":"namevalue", "type":[["cellstr","char","string"],["scalar"],["choices=tablecompletions(tbl)"]], "purpose":"a second grouping variable, one comparison set per member"},
         {"name":"pooled", "kind":"namevalue", "type":["logical","scalar"], "default":"false", "purpose":"compare the reference against every other member combined"},
         {"name":"tail", "kind":"namevalue", "type":[["char","string"],["scalar"],["choices=groupstats.namelists.testtail()"]], "default":"'both'", "purpose":"which tail the rank test uses"}
      ]
   },

   "groupstats.groupmap":
   {
      "inputs":
      [
         {"name":"tbl", "kind":"required", "type":["tabular"], "purpose":"the table to split"},
         {"name":"groupvar", "kind":"required", "type":[["cellstr","char","string"],["scalar"],["choices=tablecompletions(tbl)"]], "purpose":"the variable to group by"},
         {"name":"fcn", "kind":"required", "type":["function_handle"], "purpose":"the function applied to each group"},
         {"name":"varargin", "kind":"ordered", "repeating":true, "purpose":"arguments passed to fcn after the group table"}
      ]
   },

   "groupstats.groupbayes":
   {
      "inputs":
      [
         {"name": "tbl", "kind": "required", "type": ["tabular"], "purpose": "the table of grouped data"},
         {"name": "groupA", "kind": "required", "purpose": "the first group, as labels or logical column names"},
         {"name": "groupB", "kind": "required", "purpose": "the second group, as labels or logical column names"},
         {"name": "groupvar", "kind": "ordered", "type": [["cellstr", "char", "string"], ["scalar"], ["choices=tablecompletions(tbl)"]], "purpose": "the variable holding the group labels"},
         {"name": "Population", "kind": "namevalue", "type": [["char", "string"], ["scalar"], ["choices=groupstats.namelists.populationoption()"]], "default": "'union'", "purpose": "which rows the marginal probabilities are out of"}
      ]
   },

